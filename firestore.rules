rules_version = '2';

// Regras do banco do Controle de Peças.
// Só as contas Google listadas abaixo podem ler e gravar.
// Troque o e-mail de exemplo pelo e-mail da conta que vai usar o painel
// (pode colocar mais de um: ['a@gmail.com', 'b@gmail.com']).
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['seu.email@gmail.com'];
    }
    match /{documento=**} {
      allow read, write: if autorizado();
    }
  }
}
