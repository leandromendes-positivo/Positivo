rules_version = '2';
// Negação por padrão. O primeiro administrador é criado pelo script de implantação.
service cloud.firestore {
  match /databases/{database}/documents {
    function identidade() {
      return request.auth != null && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'microsoft.com', 'password']
        && senhaLiberada();
    }
    function senhaLiberada() {
      let caminho = /databases/$(database)/documents/credenciais_usuarios/$(request.auth.token.email.lower());
      return (!exists(caminho) && request.auth.token.firebase.sign_in_provider != 'password')
        || (exists(caminho) && get(caminho).data.uid == request.auth.uid
          && get(caminho).data.exigirTroca == false && get(caminho).data.estado == 'ativo'
          && request.auth.token.get('cpSenha', -1) == get(caminho).data.versao
          && request.auth.token.auth_time >= get(caminho).data.liberadoApartir);
    }
    function email() { return request.auth.token.email.lower(); }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(email())).data; }
    function autorizado() {
      return identidade() && perfil().ativo == true && perfil().perfil in ['usuario', 'administrador'];
    }
    function administrador() { return autorizado() && perfil().perfil == 'administrador'; }
    function autor(d) { return d.uid == request.auth.uid && d.email == email(); }
    function porValido(p) { return p.keys().hasOnly(['uid','email']) && autor(p); }
    function dataValida(d) { return d is string && (d == '' || d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function confirmacaoValida(c, tid) {
      let contato = get(/databases/$(database)/documents/contatos/$(c.contatoId)).data;
      return c.keys().hasAll(['tipo','mat','regiao','quantidade','qtdRmdf','contatoId','referenciaEmail','observacao','dataReferencia','lotesReferencia'])
        && c.keys().hasOnly(['tipo','mat','regiao','quantidade','qtdRmdf','contatoId','referenciaEmail','observacao','dataReferencia','lotesReferencia'])
        && c.tipo in ['novas','usadas'] && c.mat is string && c.mat.size() > 0 && c.mat.size() <= 100
        && c.regiao is string && c.regiao.size() <= 20
        && c.quantidade is int && c.quantidade > 0 && c.quantidade <= 1000000
        && c.qtdRmdf is int && c.qtdRmdf >= 0 && c.qtdRmdf <= c.quantidade && (c.tipo == 'novas' || c.qtdRmdf == 0)
        && c.referenciaEmail is string && c.referenciaEmail.size() > 0 && c.referenciaEmail.size() <= 200
        && c.observacao is string && c.observacao.size() <= 300
        && dataValida(c.dataReferencia) && c.dataReferencia != ''
        && c.lotesReferencia is list && c.lotesReferencia.size() <= 500
        && contato.canal == 'email' && contato.tid == tid;
    }
    function agendaValida(d, id) {
      return d.keys().hasAll(['tid','peca','previsao','anterior','versao','evento','uid','email','em'])
        && d.keys().hasOnly(['tid','peca','previsao','anterior','versao','evento','uid','email','em','confirmacao'])
        && ((d.previsao == '' && !('confirmacao' in d)) || (d.previsao != '' && confirmacaoValida(d.confirmacao, d.tid)))
        && d.tid is string && d.tid.size() > 0 && d.tid.size() <= 200 && d.peca == id
        && d.evento is string && d.evento.matches('^[a-zA-Z0-9-]{20,80}$')
        && d.versao is int && dataValida(d.previsao) && dataValida(d.anterior)
        && autor(d) && d.em == request.time;
    }
    function eventoCorreto(d) {
      return getAfter(/databases/$(database)/documents/auditoria_agendamentos/$(d.evento)).data == d;
    }
    // Perfil técnico nunca integra autorizado(): os caminhos globais continuam restritos à operação.
    function tecnico() { return identidade() && perfil().ativo == true && perfil().perfil == 'tecnico'; }
    function meuEstoque(id) {
      return tecnico() && perfil().tecnicoId == id
        && get(/databases/$(database)/documents/vinculos_tecnicos/$(id)).data.email == email();
    }
    function geracaoAtual(gen) {
      let c = get(/databases/$(database)/documents/portal/controle).data;
      let versao = exists(/databases/$(database)/documents/dados/indice) ? get(/databases/$(database)/documents/dados/indice).data.get('versao',0) : 0;
      return c.geracao == gen && c.versao == versao;
    }
    function saldoPublicado(id) {
      let gen = get(/databases/$(database)/documents/portal/controle).data.geracao;
      return get(/databases/$(database)/documents/saldos_tecnicos/$(id)/geracoes/$(gen)).data;
    }
    function vinculoValido(d) {
      let v = getAfter(/databases/$(database)/documents/vinculos_tecnicos/$(d.tecnicoId)).data;
      return d.tecnicoId is string && v.email == d.email
        && d.tecnicoId == v.regiao + '--' + v.tid
        && v.regiao in ['PR','SC','TO','RS'] && v.tid.matches('^[A-Z0-9_.-]{1,120}$');
    }
    match /vinculos_tecnicos/{id} {
      allow read: if administrador() || (tecnico() && perfil().tecnicoId == id && resource.data.email == email());
      allow create, update: if administrador() && request.resource.data.keys().hasOnly(['email','tid','regiao'])
        && id == request.resource.data.regiao + '--' + request.resource.data.tid
        && request.resource.data.regiao in ['PR','SC','TO','RS']
        && request.resource.data.tid.matches('^[A-Z0-9_.-]{1,120}$')
        && (exists(/databases/$(database)/documents/vinculos_tecnicos/$(id))
          || get(/databases/$(database)/documents/cadastro/tecnicos).data.t[request.resource.data.tid].regiao == request.resource.data.regiao
          || (saldoPublicado(id).tid == request.resource.data.tid
            && saldoPublicado(id).regiao == request.resource.data.regiao))
        && getAfter(/databases/$(database)/documents/usuarios/$(request.resource.data.email)).data.tecnicoId == id
        && getAfter(/databases/$(database)/documents/usuarios/$(request.resource.data.email)).data.perfil == 'tecnico'
        && (!exists(/databases/$(database)/documents/vinculos_tecnicos/$(id)) || resource.data.email == request.resource.data.email);
      allow delete: if administrador() && (!('tecnicoId' in getAfter(/databases/$(database)/documents/usuarios/$(resource.data.email)).data)
        || getAfter(/databases/$(database)/documents/usuarios/$(resource.data.email)).data.tecnicoId != id);
    }
    match /portal/controle {
      allow get: if autorizado() || tecnico();
      allow list: if false;
      allow create, update: if administrador() && request.resource.data.keys().hasOnly(['geracao','versao','atualizadoEm'])
        && request.resource.data.geracao is string && request.resource.data.geracao.matches('^[a-zA-Z0-9-]{20,80}$')
        && request.resource.data.versao == getAfter(/databases/$(database)/documents/dados/indice).data.versao;
      allow delete: if false;
    }
    match /saldos_tecnicos/{id}/geracoes/{gen} {
      allow get: if autorizado() || (meuEstoque(id) && geracaoAtual(gen));
      allow list: if administrador();
      allow write: if administrador();
      match /pecas/{peca} {
        allow read: if autorizado() || (meuEstoque(id) && geracaoAtual(gen));
        allow write: if administrador();
      }
    }
    function declaracaoValida(d, id, peca) {
      let p = get(/databases/$(database)/documents/saldos_tecnicos/$(id)/geracoes/$(d.geracao)/pecas/$(peca)).data;
      return d.keys().hasAll(['tecnicoId','peca','geracao','mat','tipo','quantidadeDevolver','quantidadeRmdf','rmdf','previsao','protocolo','observacao','cancelado','uid','email','versao','evento','em'])
        && d.keys().hasOnly(['tecnicoId','peca','geracao','mat','tipo','quantidadeDevolver','quantidadeRmdf','rmdf','previsao','protocolo','observacao','cancelado','uid','email','versao','evento','em'])
        && meuEstoque(id) && d.tecnicoId == id && d.peca == peca && geracaoAtual(d.geracao)
        && d.mat == p.mat && d.tipo == p.tipo && autor(d) && d.em == request.time
        && d.evento is string && d.evento.matches('^[a-zA-Z0-9-]{20,80}$') && d.versao is int
        && d.quantidadeDevolver is int && d.quantidadeDevolver >= 0
        && d.quantidadeRmdf is int && d.quantidadeRmdf >= 0
        && d.quantidadeDevolver + d.quantidadeRmdf <= p.quantidade
        && d.cancelado is bool && ((d.cancelado && d.quantidadeDevolver + d.quantidadeRmdf == 0)
          || (!d.cancelado && d.quantidadeDevolver + d.quantidadeRmdf > 0))
        && dataValida(d.previsao) && ((d.quantidadeDevolver == 0 && d.previsao == '') || (d.quantidadeDevolver > 0 && d.previsao != ''))
        && d.rmdf in ['nenhum','previsto','aplicado']
        && ((d.quantidadeRmdf == 0 && d.rmdf == 'nenhum') || (d.quantidadeRmdf > 0 && d.tipo == 'novas' && d.rmdf in ['previsto','aplicado']))
        && d.protocolo is string && d.protocolo.size() <= 100 && (d.rmdf != 'aplicado' || d.protocolo.size() > 0)
        && d.observacao is string && d.observacao.size() <= 500;
    }
    match /declaracoes_tecnicos/{id}/itens/{peca} {
      allow read: if autorizado() || meuEstoque(id);
      allow create, update: if declaracaoValida(request.resource.data,id,peca)
        && request.resource.data.versao == (exists(/databases/$(database)/documents/declaracoes_tecnicos/$(id)/itens/$(peca)) ? resource.data.versao + 1 : 1)
        && getAfter(/databases/$(database)/documents/eventos_tecnicos/$(request.resource.data.evento)).data == request.resource.data;
      allow delete: if false;
    }
    match /eventos_tecnicos/{id} {
      allow read: if autorizado() || meuEstoque(resource.data.tecnicoId);
      allow create: if request.resource.data.evento == id
        && declaracaoValida(request.resource.data,request.resource.data.tecnicoId,request.resource.data.peca)
        && getAfter(/databases/$(database)/documents/declaracoes_tecnicos/$(request.resource.data.tecnicoId)/itens/$(request.resource.data.peca)).data == request.resource.data;
      allow update, delete: if false;
    }

    match /usuarios/{id} {
      allow get: if identidade() && (id == email() || administrador());
      allow list: if administrador();
      function valido(d) {
        return d.keys().hasAll(['email','perfil','ativo','principal','criadoEm','criadoPor','atualizadoEm','atualizadoPor'])
          && d.keys().hasOnly(['email','perfil','ativo','principal','criadoEm','criadoPor','atualizadoEm','atualizadoPor','nome','tecnicoId'])
          && (!('nome' in d) || (d.nome is string && d.nome.size() > 0 && d.nome.size() <= 80
            && d.nome.matches('^\\S(.*\\S)?$') && d.nome.matches('^[^<>\\x00-\\x1F\\x7F]+$')))
          && d.email == id && id == id.lower() && id.size() <= 254 && id.matches('^[^ /@]+@[^ /@]+[.][^ /@]+$')
          && d.perfil in ['usuario','administrador','tecnico']
          && ((d.perfil == 'tecnico' && 'tecnicoId' in d && vinculoValido(d)) || (d.perfil != 'tecnico' && !('tecnicoId' in d))) && d.ativo is bool && d.principal is bool
          && d.atualizadoEm == request.time && porValido(d.atualizadoPor);
      }
      allow create: if administrador() && valido(request.resource.data)
        && request.resource.data.principal == false && request.resource.data.criadoEm == request.time
        && porValido(request.resource.data.criadoPor);
      allow update: if (autorizado() || tecnico()) && valido(request.resource.data)
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.principal == resource.data.principal
        && ((id == email() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','atualizadoEm','atualizadoPor'])
            && 'nome' in request.resource.data)
          // O principal é imutável para terceiros; nenhum administrador gerencia a própria permissão.
          || (administrador() && resource.data.principal == false && id != email()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perfil','ativo','tecnicoId','atualizadoEm','atualizadoPor'])));
      allow delete: if false;
    }
    match /servicos/lembretes-ferias { allow get: if autorizado(); allow list, write: if false; }
    match /testes_lembretes_ferias/{id} {
      allow get: if autorizado() && id == request.auth.uid;
      allow list: if false;
      allow delete: if autorizado() && id == request.auth.uid
        && (!('estado' in resource.data) || !(resource.data.estado in ['em_envio','incerto']));
      function pedidoValido() {
        return autorizado() && id == request.auth.uid
          && request.resource.data.keys().hasAll(['uid','pedido','solicitadoEm'])
          && request.resource.data.keys().hasOnly(['uid','pedido','solicitadoEm'])
          && request.resource.data.uid == id
          && request.resource.data.pedido is string
          && request.resource.data.pedido.matches('^[a-zA-Z0-9-]{20,80}$')
          && request.resource.data.solicitadoEm == request.time
          && exists(/databases/$(database)/documents/lembretes_ferias/$(id));
      }
      allow create: if pedidoValido();
      allow update: if pedidoValido()
        && resource.data.estado in ['enviado','falhou','indisponivel']
        && request.time > resource.data.solicitadoEm + duration.value(60, 's');
    }
    match /lembretes_ferias/{id} {
      allow get: if autorizado() && id == request.auth.uid;
      allow list: if false;
      function valida(d) {
        return d.keys().hasAll(['uid','titular','email','ativo','versao','criadoEm','atualizadoEm'])
          && d.keys().hasOnly(['uid','titular','email','ativo','versao','criadoEm','atualizadoEm','horario','antecedencia'])
          && (!('horario' in d) || (d.horario is string && d.horario.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
          && (!('antecedencia' in d) || (d.antecedencia is int && d.antecedencia >= 1 && d.antecedencia <= 90))
          && d.uid == id && id == request.auth.uid && d.titular == email()
          && d.email is string && d.email.size() <= 254 && d.email == d.email.lower()
          && d.email.matches('^[a-z0-9.!#$%&\'*+/?=^_`{|}~-]+@[a-z0-9-]+([.][a-z0-9-]+)+$')
          && d.ativo is bool && d.versao is int && d.atualizadoEm == request.time;
      }
      allow create: if autorizado() && valida(request.resource.data)
        && request.resource.data.versao == 1 && request.resource.data.criadoEm == request.time;
      allow update: if autorizado() && valida(request.resource.data)
        && request.resource.data.versao == resource.data.versao + 1
        && request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if autorizado() && id == request.auth.uid;
    }
    function feriasValidas(d) {
      return d.keys().hasAll(['id','nome','matricula','regiao','ciclo','status','direito','vendidos','obs','periodos','versao','atualizadoEm','atualizadoPor','evento'])
        && d.keys().hasOnly(['id','nome','matricula','regiao','ciclo','status','direito','vendidos','obs','periodos','versao','atualizadoEm','atualizadoPor','evento','arquivado','area','localidade'])
        && (!('arquivado' in d) || d.arquivado is bool)
        && ((!('area' in d) && !('localidade' in d))
          || ('area' in d && 'localidade' in d && d.regiao in ['PR','SC','TO','RS']
            && ((d.area == 'administrativo' && d.localidade == '')
              || (d.area == 'tecnico' && d.localidade in ['','interior','capital']))))
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 120
        && d.matricula is string && d.matricula.matches('^[A-Za-z0-9_-]{1,40}$')
        && d.regiao is string && d.regiao.size() <= 40
        && d.ciclo is string && d.ciclo.size() > 0 && d.ciclo.size() <= 40
        && d.obs is string && d.obs.size() <= 1000
        && d.status in ['planejado','confirmado','cancelado']
        && d.direito is int && d.direito >= 1 && d.direito <= 60
        && d.vendidos is int && d.vendidos >= 0 && d.vendidos <= 20
        && d.periodos is list && d.periodos.size() >= 0 && d.periodos.size() <= 3
        && (d.periodos.size() < 1 || periodoFeriasValido(d.periodos[0]))
        && (d.periodos.size() < 2 || periodoFeriasValido(d.periodos[1]))
        && (d.periodos.size() < 3 || periodoFeriasValido(d.periodos[2]))
        && d.evento is string && d.evento.matches('^[a-zA-Z0-9-]{20,80}$')
        && d.versao is int && d.atualizadoEm == request.time && porValido(d.atualizadoPor);
    }
    function periodoFeriasValido(p) {
      return p.keys().hasAll(['inicio','fim','retorno']) && p.keys().hasOnly(['inicio','fim','retorno'])
        && dataValida(p.inicio) && p.inicio != '' && dataValida(p.fim) && p.fim >= p.inicio
        && dataValida(p.retorno) && (p.retorno == '' || p.retorno > p.fim);
    }
    function exclusaoFeriasValida(d, cadastroId, versao) {
      return d.keys().hasAll(['cadastroId','versao','por','em'])
        && d.keys().hasOnly(['cadastroId','versao','por','em'])
        && d.cadastroId == cadastroId && d.versao == versao
        && porValido(d.por) && d.em == request.time;
    }
    match /exclusoes_ferias/{id} {
      allow read: if administrador();
      allow create: if administrador()
        && get(/databases/$(database)/documents/ferias/$(request.resource.data.cadastroId)).data.evento == id
        && exclusaoFeriasValida(request.resource.data, request.resource.data.cadastroId,
          get(/databases/$(database)/documents/ferias/$(request.resource.data.cadastroId)).data.versao)
        && !existsAfter(/databases/$(database)/documents/ferias/$(request.resource.data.cadastroId));
      allow update, delete: if false;
    }
    match /ferias/{id} {
      allow read: if autorizado();
      allow create: if administrador() && feriasValidas(request.resource.data)
        && request.resource.data.id == id && request.resource.data.versao == 1
        && getAfter(/databases/$(database)/documents/historico_ferias/$(request.resource.data.evento)).data == request.resource.data;
      allow update: if administrador() && feriasValidas(request.resource.data)
        && request.resource.data.id == id && request.resource.data.versao == resource.data.versao + 1
        && getAfter(/databases/$(database)/documents/historico_ferias/$(request.resource.data.evento)).data == request.resource.data;
      allow delete: if administrador() && exclusaoFeriasValida(
        getAfter(/databases/$(database)/documents/exclusoes_ferias/$(resource.data.evento)).data, id, resource.data.versao);
    }
    match /historico_ferias/{id} {
      allow read: if autorizado();
      allow create: if administrador() && feriasValidas(request.resource.data)
        && request.resource.data.evento == id
        && getAfter(/databases/$(database)/documents/ferias/$(request.resource.data.id)).data == request.resource.data;
      allow update, delete: if false;
    }
    match /seguranca/{id} { allow read: if autorizado() || (tecnico() && id == 'portal'); allow write: if false; }
    match /agendamentos/{id} {
      allow read: if autorizado();
      allow create: if autorizado() && agendaValida(request.resource.data, id)
        && request.resource.data.versao == 1 && eventoCorreto(request.resource.data);
      allow update: if autorizado() && agendaValida(request.resource.data, id)
        && request.resource.data.tid == resource.data.tid
        && request.resource.data.versao == resource.data.versao + 1
        && request.resource.data.anterior == resource.data.previsao && eventoCorreto(request.resource.data);
      allow delete: if false;
    }
    match /auditoria_agendamentos/{id} {
      allow read: if autorizado();
      allow create: if autorizado() && request.resource.data.evento == id
        && agendaValida(request.resource.data, request.resource.data.peca)
        && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.peca)).data == request.resource.data;
      allow update, delete: if false;
    }
    match /contatos/{id} {
      allow read: if autorizado();
      allow create: if autorizado() && request.resource.data.keys().hasAll(['tid','canal','previsao','obs','pecas','itens','uid','email','em'])
        && request.resource.data.keys().hasOnly(['tid','canal','previsao','obs','pecas','itens','uid','email','em','tipo','detalhes','referencia','ordem'])
        && (!('ordem' in request.resource.data) || request.resource.data.ordem is int)
        && (!('detalhes' in request.resource.data) || (request.resource.data.detalhes is list && request.resource.data.detalhes.size() <= 500))
        && (!('referencia' in request.resource.data) || (request.resource.data.referencia is map && request.resource.data.referencia.keys().hasOnly(['dataReferencia','lotesReferencia']) && dataValida(request.resource.data.referencia.dataReferencia) && request.resource.data.referencia.lotesReferencia is list && request.resource.data.referencia.lotesReferencia.size() <= 500))
        && (!('tipo' in request.resource.data) || request.resource.data.tipo in ['novas','usadas','mistas'])
        && autor(request.resource.data) && request.resource.data.em == request.time
        && request.resource.data.tid is string && request.resource.data.tid.size() <= 200
        && request.resource.data.canal in ['whatsapp','ligacao','email','pessoalmente','outro']
        && dataValida(request.resource.data.previsao)
        && request.resource.data.obs is string && request.resource.data.obs.size() <= 300
        && request.resource.data.pecas is number && request.resource.data.pecas >= 0
        && request.resource.data.itens is list && request.resource.data.itens.size() <= 500;
      allow update, delete: if false;
    }
    match /anotacoes/{id} {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.resource.data.keys().hasOnly(['tid','peca','texto','uid','email','em'])
        && request.resource.data.peca == id && request.resource.data.tid is string
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 1000
        && autor(request.resource.data) && request.resource.data.em == request.time;
      allow delete: if false;
    }
    // Legado somente para leitura: autoria nova não pode ser adulterada por esse caminho.
    match /acompanhamento/{id} { allow read: if autorizado(); allow write: if false; }
    match /{colecao}/{id} {
      allow read: if autorizado() && colecao in ['config','cadastro','dados','devolucoes','movimentos','historico','importacoes','resumo'];
      allow write: if administrador() && colecao in ['config','cadastro','dados','devolucoes','movimentos','historico','importacoes','resumo']
        && (colecao != 'dados' || id != 'indice' || (request.resource.data.versao is int
          && getAfter(/databases/$(database)/documents/portal/controle).data.versao == request.resource.data.versao
          && (!exists(/databases/$(database)/documents/dados/indice) || request.resource.data.versao == resource.data.get('versao',0) + 1)));
    }
  }
}
