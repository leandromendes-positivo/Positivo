rules_version = '2';
// Negação por padrão. O primeiro administrador é criado pelo script de implantação.
service cloud.firestore {
  match /databases/{database}/documents {
    function identidade() {
      return request.auth != null && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'microsoft.com'];
    }
    function email() { return request.auth.token.email.lower(); }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(email())).data; }
    function autorizado() {
      return identidade() && perfil().ativo == true && perfil().perfil in ['usuario', 'administrador'];
    }
    function administrador() { return autorizado() && perfil().perfil == 'administrador'; }
    function autor(d) { return d.uid == request.auth.uid && d.email == email(); }
    function porValido(p) { return p.keys().hasOnly(['uid','email']) && autor(p); }
    function dataValida(d) { return d is string && (d == '' || d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function agendaValida(d, id) {
      return d.keys().hasAll(['tid','peca','previsao','anterior','versao','evento','uid','email','em'])
        && d.keys().hasOnly(['tid','peca','previsao','anterior','versao','evento','uid','email','em'])
        && d.tid is string && d.tid.size() > 0 && d.tid.size() <= 200 && d.peca == id
        && d.evento is string && d.evento.matches('^[a-zA-Z0-9-]{20,80}$')
        && d.versao is int && dataValida(d.previsao) && dataValida(d.anterior)
        && autor(d) && d.em == request.time;
    }
    function eventoCorreto(d) {
      return getAfter(/databases/$(database)/documents/auditoria_agendamentos/$(d.evento)).data == d;
    }
    match /usuarios/{id} {
      allow get: if identidade() && (id == email() || administrador());
      allow list: if administrador();
      function valido(d) {
        return d.keys().hasAll(['email','perfil','ativo','principal','criadoEm','criadoPor','atualizadoEm','atualizadoPor'])
          && d.keys().hasOnly(['email','perfil','ativo','principal','criadoEm','criadoPor','atualizadoEm','atualizadoPor'])
          && d.email == id && id == id.lower() && id.size() <= 254 && id.matches('^[^ /@]+@[^ /@]+[.][^ /@]+$')
          && d.perfil in ['usuario','administrador'] && d.ativo is bool && d.principal is bool
          && d.atualizadoEm == request.time && porValido(d.atualizadoPor);
      }
      allow create: if administrador() && valido(request.resource.data)
        && request.resource.data.principal == false && request.resource.data.criadoEm == request.time
        && porValido(request.resource.data.criadoPor);
      allow update: if administrador() && valido(request.resource.data)
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.principal == resource.data.principal
        && (!(resource.data.principal || id == email()) || (request.resource.data.ativo == true && request.resource.data.perfil == 'administrador'));
      allow delete: if false;
    }
    match /seguranca/{id} { allow read: if autorizado(); allow write: if false; }
    match /agendamentos/{id} {
      allow read: if autorizado();
      allow create: if autorizado() && agendaValida(request.resource.data, id)
        && request.resource.data.versao == 1 && eventoCorreto(request.resource.data);
      allow update: if autorizado() && agendaValida(request.resource.data, id)
        && request.resource.data.tid == resource.data.tid
        && request.resource.data.versao == resource.data.versao + 1
        && request.resource.data.anterior == resource.data.previsao && eventoCorreto(request.resource.data);
      allow delete: if false;
    }
    match /auditoria_agendamentos/{id} {
      allow read: if autorizado();
      allow create: if autorizado() && request.resource.data.evento == id
        && agendaValida(request.resource.data, request.resource.data.peca)
        && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.peca)).data == request.resource.data;
      allow update, delete: if false;
    }
    match /contatos/{id} {
      allow read: if autorizado();
      allow create: if autorizado() && request.resource.data.keys().hasAll(['tid','canal','previsao','obs','pecas','itens','uid','email','em'])
        && request.resource.data.keys().hasOnly(['tid','canal','previsao','obs','pecas','itens','uid','email','em','tipo'])
        && (!('tipo' in request.resource.data) || request.resource.data.tipo in ['novas','usadas'])
        && autor(request.resource.data) && request.resource.data.em == request.time
        && request.resource.data.tid is string && request.resource.data.tid.size() <= 200
        && request.resource.data.canal in ['whatsapp','ligacao','email','pessoalmente','outro']
        && dataValida(request.resource.data.previsao)
        && request.resource.data.obs is string && request.resource.data.obs.size() <= 300
        && request.resource.data.pecas is number && request.resource.data.pecas >= 0
        && request.resource.data.itens is list && request.resource.data.itens.size() <= 500;
      allow update, delete: if false;
    }
    match /anotacoes/{id} {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.resource.data.keys().hasOnly(['tid','peca','texto','uid','email','em'])
        && request.resource.data.peca == id && request.resource.data.tid is string
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 1000
        && autor(request.resource.data) && request.resource.data.em == request.time;
      allow delete: if false;
    }
    // Legado somente para leitura: autoria nova não pode ser adulterada por esse caminho.
    match /acompanhamento/{id} { allow read: if autorizado(); allow write: if false; }
    match /{colecao}/{id} {
      allow read: if autorizado() && colecao in ['config','cadastro','dados','devolucoes','movimentos','historico','importacoes','resumo'];
      allow write: if administrador() && colecao in ['config','cadastro','dados','devolucoes','movimentos','historico','importacoes','resumo'];
    }
  }
}
